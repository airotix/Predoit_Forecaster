# ============================================================================
# Forecaster — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` (also at the project root) and edit values you
# want to override. Anything not set falls back to the defaults shown here.
# Process environment variables always win over .env values.
#
# Backend (FastAPI + ML pipeline) reads .env via python-dotenv at config.py
# import time. Frontend (Next.js) does NOT read this file — see the section
# at the bottom for the frontend variable.
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
# Absolute or relative path to the SQLite forecast.db. If unset, the canonical
# location backend-ai/data/forecast.db is used.
# FORECASTER_DB_PATH=

# ----------------------------------------------------------------------------
# API SERVER
# ----------------------------------------------------------------------------
# Host the FastAPI server binds to. Use 127.0.0.1 to limit to localhost.
FORECASTER_API_HOST=0.0.0.0

# TCP port the FastAPI server listens on.
FORECASTER_API_PORT=4000

# Enable uvicorn auto-reload on source changes. Set to false in production.
# Accepts: 1/0, true/false, yes/no, on/off.
FORECASTER_API_RELOAD=true

# Comma-separated list of origins allowed for browser CORS requests.
# Order matters: the first entry is used as the fallback "Origin" header
# when an incoming request has no/disallowed origin.
FORECASTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# DATA INPUT (raw historical sales CSV consumed by the ML pipeline)
# ----------------------------------------------------------------------------
# Full path to the source CSV (absolute, or relative to project root).
# If unset, defaults to backend-ai/data/raw/THE_FINAL_10Y_cleaned.csv.
# FORECASTER_DATA_FILE=

# Field separator for the source CSV.
FORECASTER_DATA_SEPARATOR=,

# Text encoding for the source CSV.
FORECASTER_DATA_ENCODING=utf-8

# ----------------------------------------------------------------------------
# FORECASTING — temporal & horizon
# ----------------------------------------------------------------------------
# Number of months to forecast forward.
FORECASTER_FORECAST_HORIZON_MONTHS=6

# SARIMA seasonality (12 = monthly data with yearly cycle).
FORECASTER_SARIMA_SEASONAL_PERIOD=12

# Minimum span of months in history required to train SARIMA on a SKU.
FORECASTER_SARIMA_MIN_MONTHS_SPAN=36

# Minimum number of months with data required to use CatBoost on a SKU.
FORECASTER_CATBOOST_MIN_MONTHS=3

# ----------------------------------------------------------------------------
# FORECASTING — SARIMA search space
# ----------------------------------------------------------------------------
FORECASTER_SARIMA_P_MAX=2
FORECASTER_SARIMA_D_MAX=1
FORECASTER_SARIMA_Q_MAX=2
FORECASTER_SARIMA_SP_MAX=1
FORECASTER_SARIMA_SD_MAX=1
FORECASTER_SARIMA_SQ_MAX=1

# ----------------------------------------------------------------------------
# FORECASTING — CatBoost hyperparameters
# ----------------------------------------------------------------------------
# Lower iterations for fast dev runs; raise for production accuracy.
FORECASTER_CATBOOST_ITERATIONS=1000
FORECASTER_CATBOOST_DEPTH=6
FORECASTER_CATBOOST_LEARNING_RATE=0.05
FORECASTER_CATBOOST_L2_REG=3.0
FORECASTER_CATBOOST_EARLY_STOPPING=50

# ----------------------------------------------------------------------------
# FORECASTING — scenario quantiles
# ----------------------------------------------------------------------------
# Quantiles used for conservative / base / optimistic forecast scenarios.
FORECASTER_QUANTILE_CONSERVATIVE=0.20
FORECASTER_QUANTILE_BASE=0.50
FORECASTER_QUANTILE_OPTIMISTIC=0.80

# ----------------------------------------------------------------------------
# SIZE CURVES
# ----------------------------------------------------------------------------
# Minimum total units required before trusting a product-specific size curve.
FORECASTER_MIN_UNITS_FOR_PRODUCT_SIZE_CURVE=30

# Maximum share any single size can take of a product (0.35 = 35%).
FORECASTER_SIZE_MAX_SHARE_CAP=0.35

# Minimum quantity per size (0 disables the floor).
FORECASTER_SIZE_MIN_QTY=0

# Dampening factor applied to extreme sizes (1.0 = no dampening).
FORECASTER_EXTREME_SIZE_DAMPENING_FACTOR=1.0

# ----------------------------------------------------------------------------
# FINANCIAL
# ----------------------------------------------------------------------------
# Default cost as a fraction of price when no explicit cost is available.
FORECASTER_DEFAULT_COST_RATIO=0.50

# Optional override for target margin rate. Leave blank to use the default
# (None) — only set if you know the value you want enforced.
# FORECASTER_TARGET_MARGIN_RATE=

# Optional override for the seasonal budget. Leave blank to use the default
# (None — derived from purchase cost x BUDGET_MULTIPLIER on the API).
# FORECASTER_SEASONAL_BUDGET=

# Multiplier applied to total purchase cost to derive the displayed seasonal
# budget on the dashboard / budget / validation pages.
FORECASTER_BUDGET_MULTIPLIER=1.2

# Target gross margin percentage shown next to each SKU on the recommendations
# and budget pages (display-only — does not change forecasts).
FORECASTER_TARGET_MARGIN_DISPLAY=45

# ----------------------------------------------------------------------------
# ACTIVE CLIENT
# ----------------------------------------------------------------------------
# A client is considered "active" if they ordered within this many months.
FORECASTER_ACTIVE_CLIENT_LOOKBACK_MONTHS=24

# ----------------------------------------------------------------------------
# OUTPUT
# ----------------------------------------------------------------------------
# Directory (absolute or relative to backend-ai/) for pipeline CSV outputs.
FORECASTER_OUTPUT_DIR=output/

# File names emitted by the ML pipeline and read by the API at /health.
FORECASTER_OUTPUT_RECOMMENDATIONS_FILE=recommendations.csv
FORECASTER_OUTPUT_SUMMARY_FILE=summary_report.csv
FORECASTER_OUTPUT_MODEL_PERFORMANCE_FILE=model_performance.csv
FORECASTER_OUTPUT_MONTHLY_DETAIL_FILE=forecast_monthly_detail.csv

# ----------------------------------------------------------------------------
# THREADING / REAL-TIME
# ----------------------------------------------------------------------------
# Worker threads used to run the forecast pipeline triggered via
# POST /api/forecast/refresh. Keep at 1 unless you know the pipeline is
# safe to run concurrently.
FORECASTER_FORECAST_THREAD_POOL_SIZE=1

# Polling interval (seconds) for the /api/events SSE stream.
FORECASTER_SSE_POLL_INTERVAL_SECONDS=5

# ----------------------------------------------------------------------------
# BACKTEST
# ----------------------------------------------------------------------------
# Months held out at the end of history for walk-forward accuracy backtesting.
FORECASTER_BACKTEST_HOLDOUT_MONTHS=6

# ----------------------------------------------------------------------------
# AUTHENTICATION — Azure Entra ID (Microsoft Entra / Azure AD)
# ----------------------------------------------------------------------------
# Roles (highest to lowest privilege): owner = admin (top) > manager > worker.
#   owner   : business owner — full access
#   admin   : system / IT admin — full access
#   manager : view + overrides, locks, season config, budget, approvals
#   worker  : VIEW-ONLY — dashboards, products, projections; no writes
#
# Map these Azure Entra app roles on the API app registration:
#   Preduit.Owner, Preduit.Admin, Preduit.Manager, Preduit.Worker
# (legacy Preduit.User is still accepted and maps to worker).
#
# ⚠️  SECURITY: the two defaults below are for LOCAL DEV ONLY. With auth
#     inactive, EVERY request is granted a synthetic admin user and the API
#     boots with a loud SECURITY WARNING in the logs. For any shared or
#     client-facing deployment you MUST set:
#         FORECASTER_AUTH_ENABLED=true
#         FORECASTER_AUTH_DEV_BYPASS=false
#     and provide the three FORECASTER_AZURE_* values below.

# Master switch. Leave false only for local development.
FORECASTER_AUTH_ENABLED=false

# When true (and only used when AUTH_ENABLED is false), bypasses auth and
# injects a synthetic dev user. Set to false in every real deployment.
FORECASTER_AUTH_DEV_BYPASS=true

# Role granted to the synthetic dev user when auth is inactive.
# One of: worker | manager | admin | owner.
FORECASTER_AUTH_DEV_ROLE=admin

# Azure Entra directory (tenant) ID — GUID from the app registration overview.
FORECASTER_AZURE_TENANT_ID=

# Azure Entra application (client) ID of the API app registration.
FORECASTER_AZURE_CLIENT_ID=

# Expected audience of incoming access tokens. Defaults to the client ID above
# if left blank; set explicitly if you exposed a custom Application ID URI.
FORECASTER_AZURE_API_AUDIENCE=

# ----------------------------------------------------------------------------
# ERP INTEGRATION — Joolan / Lisa API v2
# ----------------------------------------------------------------------------
# Dormant until enabled with credentials. While disabled, the manual "ERP Sync"
# button falls back to bundled sample data (and CSV/XLSX upload remains available).
#
# ⚠️  The API key is sent as a query parameter (Joolan requirement). Keep it in a
#     secret store, use HTTPS only, and never expose it to the browser.
FORECASTER_ERP_ENABLED=false

# Joolan API base URL.
FORECASTER_ERP_BASE_URL=https://lisa.joolan.com/api/v2

# Enseigne (Joolan database/store name) and API key with api_query + api_stock
# + api_catalogue permissions.
FORECASTER_ERP_ENSEIGNE=
FORECASTER_ERP_API_KEY=

# Optional store filter (';'-separated). Empty = all stores.
FORECASTER_ERP_MAGASINS=

# Read-only SQL for /query.do, set once Joolan's table/column names are known.
# Each query MUST alias its output columns to the names the pipeline expects
# (e.g. SELECT ... AS "Référence", ... AS "LIV_qte", ...).
#   HISTORY: line-level demand history (client + product + qty + price + stock).
#   COST:    per-unit purchase cost (Produit, Couleur, Taille, Prix_Achat).
FORECASTER_ERP_HISTORY_SQL=
FORECASTER_ERP_COST_SQL=

# ============================================================================
# FRONTEND (informational — Next.js does NOT read this .env file)
# ----------------------------------------------------------------------------
# Next.js loads its own env from frontend/.env.local. Copy
# frontend/.env.local.example to frontend/.env.local and edit it. The browser
# variables it needs are:
#
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api
#   NEXT_PUBLIC_AUTH_ENABLED=false
#   NEXT_PUBLIC_AUTH_DEV_ROLE=admin
#   NEXT_PUBLIC_AZURE_CLIENT_ID=
#   NEXT_PUBLIC_AZURE_TENANT_ID=
#   NEXT_PUBLIC_AZURE_API_SCOPE=api://<client-id>/access_as_user
#
# Keep NEXT_PUBLIC_AUTH_ENABLED in sync with FORECASTER_AUTH_ENABLED above.
# ============================================================================
