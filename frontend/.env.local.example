# ============================================================================
# Preduit frontend (Next.js) — browser environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `frontend/.env.local` and edit the values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
#
# Keep the auth values in sync with the backend .env:
#   NEXT_PUBLIC_AUTH_ENABLED   <-> FORECASTER_AUTH_ENABLED
#   NEXT_PUBLIC_AZURE_TENANT_ID <-> FORECASTER_AZURE_TENANT_ID
#   NEXT_PUBLIC_AZURE_CLIENT_ID <-> FORECASTER_AZURE_CLIENT_ID
# ============================================================================

# Base URL the browser calls for the API. Default is http://localhost:4000/api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ----------------------------------------------------------------------------
# AUTHENTICATION (Azure Entra ID via MSAL)
# ----------------------------------------------------------------------------
# Roles (highest to lowest): owner = admin (top) > manager > worker (view-only).
#
# Master switch. Leave false for local dev; set true for real deployments.
NEXT_PUBLIC_AUTH_ENABLED=false

# Role assumed for the dev user when auth is disabled.
# One of: worker | manager | admin | owner.
NEXT_PUBLIC_AUTH_DEV_ROLE=admin

# Azure Entra application (client) ID of the SPA / frontend app registration.
NEXT_PUBLIC_AZURE_CLIENT_ID=

# Azure Entra directory (tenant) ID.
NEXT_PUBLIC_AZURE_TENANT_ID=

# OAuth scope requested for the API. Typically api://<api-client-id>/access_as_user.
NEXT_PUBLIC_AZURE_API_SCOPE=
