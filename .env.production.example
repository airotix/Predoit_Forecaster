# ============================================================================
# Preduit — PRODUCTION environment template
# ----------------------------------------------------------------------------
# Copy to `.env` for docker compose, or feed these as container/Key Vault
# secrets on Azure. This template has production-safe defaults; the dev
# `.env.example` has the full list of tunable pipeline parameters.
# ============================================================================

# ── API server ──
FORECASTER_API_HOST=0.0.0.0
FORECASTER_API_PORT=4000
# MUST be false in production (no auto-reload).
FORECASTER_API_RELOAD=false
# Comma-separated list of the exact browser origin(s) of the frontend.
FORECASTER_CORS_ORIGINS=https://app.your-domain.com

# ── Data / DB (container volume paths; override the legacy backend-ai/ anchor) ──
FORECASTER_DB_PATH=/data/forecast.db
FORECASTER_OUTPUT_DIR=/data/output
# Path to the raw source CSV inside the container/volume (if running the pipeline).
# FORECASTER_DATA_FILE=/data/raw/history.csv

# ── Authentication (see .env.example for the full reference) ──
# MUST be enabled in production; dev bypass MUST be off.
FORECASTER_AUTH_ENABLED=true
FORECASTER_AUTH_DEV_BYPASS=false
FORECASTER_AZURE_TENANT_ID=
FORECASTER_AZURE_CLIENT_ID=
FORECASTER_AZURE_API_AUDIENCE=
# Strong random secret for local email/password session tokens (e.g. `openssl rand -base64 48`).
FORECASTER_AUTH_SECRET=
FORECASTER_AUTH_TOKEN_TTL_HOURS=12
FORECASTER_AUTH_ALLOW_SIGNUP=true

# ── Financial defaults (overridable per season in the UI) ──
FORECASTER_DEFAULT_COST_RATIO=0.50
FORECASTER_BUDGET_MULTIPLIER=1.2

# ── ERP (Joolan / Lisa) — leave disabled until credentials exist ──
FORECASTER_ERP_ENABLED=false
FORECASTER_ERP_BASE_URL=https://lisa.joolan.com/api/v2
FORECASTER_ERP_ENSEIGNE=
FORECASTER_ERP_API_KEY=
FORECASTER_ERP_MAGASINS=
FORECASTER_ERP_HISTORY_SQL=
FORECASTER_ERP_COST_SQL=

# ============================================================================
# FRONTEND build args (baked into the image at build time — pass to
# `docker compose build` or the CI build, NOT read at container runtime).
# Keep these in sync with the auth settings above.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_DEV_ROLE=admin
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_API_SCOPE=
# ============================================================================
